{
  "name": "chatty-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^0.27.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "emoji-picker-react": "^4.17.4",
    "history": "^5.3.0",
    "joi": "^18.0.2",
    "lodash": "^4.17.23",
    "moment": "^2.30.1",
    "react": "^19.2.0",
    "react-app-rewired": "^2.2.1",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.6",
    "react-icons": "^5.5.0",
    "react-loading-skeleton": "^3.5.0",
    "react-masonry-css": "^1.0.16",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "react-toastify": "^11.0.5",
    "sass": "^1.94.2",
    "socket.io-client": "^4.8.3",
    "sweetalert2": "^11.26.18",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "lint:check": "eslint src/**/*.js",
    "lint:fix": "eslint 'src/**/*.js' --fix",
    "prettier:check": "prettier --check 'src/**/*.{js,jsx,json}'",
    "prettier:fix": "prettier --write 'src/**/*.{js,jsx,json}'",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test --coverage --forceExit --detectOpenHandles --watchAll=false"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^8.22.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.8.3",
    "eslint-plugin-n": "^15.2.4",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.30.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "jest-canvas-mock": "^2.5.2",
    "msw": "^0.44.2",
    "prettier": "^2.8.8",
    "react-app-alias": "^2.2.2",
    "web-streams-polyfill": "^4.2.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/test/*.js?(x)",
      "!**/node_modules/**"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "moduleNameMapper": {
      "@components/(.*)": [
        "<rootDir>/src/components/$1"
      ],
      "@services/(.*)": [
        "<rootDir>/src/services/$1"
      ],
      "@hooks/(.*)": [
        "<rootDir>/src/hooks/$1"
      ],
      "@mocks/(.*)": [
        "<rootDir>/src/mocks/$1"
      ],
      "@pages/(.*)": [
        "<rootDir>/src/pages/$1"
      ],
      "@redux/(.*)": [
        "<rootDir>/src/redux-toolkit/$1"
      ],
      "@assets/(.*)": [
        "<rootDir>/src/assets/$1"
      ],
      "@colors/(.*)": [
        "<rootDir>/src/colors/$1"
      ],
      "@root/(.*)": [
        "<rootDir>/src/$1"
      ]
    }
  }
}
